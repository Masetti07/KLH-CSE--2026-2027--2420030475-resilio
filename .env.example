# ResilioSpace environment template
#
# Phase 0 requires no environment variables or API keys.
# Future settings must use non-secret development-safe placeholders here.
# Never place real credentials or tokens in this file.

# Optional: override the backend's local runtime directory.
# RESILIOSPACE_RUNTIME_DIR=./src/backend/runtime

# Additional comma-separated frontend origins; localhost development stays enabled.
# RESILIOSPACE_CORS_ORIGINS=https://your-project.pages.dev
# Disable administrative simulator actions and global telemetry writes on public hosts.
# RESILIOSPACE_PUBLIC_DEMO=true
# Public portfolio: anonymous stateless processing and browser-local designs.
# RESILIOSPACE_GUEST_DEMO=true
# Optional legacy password mode; leave unset for the public guest deployment.
# Set only in the backend environment dashboard, never in VITE variables.
# RESILIOSPACE_DEMO_PASSWORD=<set-in-render-only>
# Repository root is the working directory on Render (see docs/deployment-render.md).
# RESILIOSPACE_SAMPLE_DIR=data

# Optional Docker Compose host-port overrides.
# FRONTEND_PORT=8080
# BACKEND_PORT=8000
# PROMETHEUS_PORT=9090

# Optional local frontend API base. Docker builds use the nginx /api proxy.
# VITE_API_URL=http://127.0.0.1:8000
# Cloudflare Production build (public values; never put credentials here):
# VITE_API_URL=https://resiliospace-api.onrender.com
# VITE_GUEST_DEMO=true
